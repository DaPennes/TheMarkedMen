<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>TheMarkedMen_VictimRemorse</defName>
    <label>victim remorse</label>
    <description>They Remember Everything The things they've Done</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <statOffsets>
          <MentalBreakThreshold>0.15</MentalBreakThreshold>
          <WorkSpeedGlobal>-0.15</WorkSpeedGlobal>
          <GlobalLearningFactor>-0.10</GlobalLearningFactor>
          <SocialImpact>-0.15</SocialImpact>
        </statOffsets>
        <statFactors>
          <MoveSpeed>0.95</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_ThoughtSetter">
        <thought>TheMarkedMen_IRememberEverything</thought>
      </li>
    </comps>
  </HediffDef>
</Defs>
