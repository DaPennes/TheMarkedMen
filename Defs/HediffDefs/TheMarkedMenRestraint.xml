<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>CA_Restrained</defName>
    <label>restrained</label>
    <description>This pawn has been physically restrained on a bed with heavy chains. Movement and attacks are impossible.\n\nWhen restrained, the Marked Virus progression is unaffected but the prisoner cannot attack wardens, harm themselves, or escape.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.01</initialSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>securing</label>
        <painFactor>0.75</painFactor>
        <hungerRateFactor>1.15</hungerRateFactor>
        <restFallFactor>2</restFallFactor>
        <statFactors>
          <RestRateMultiplier>0.001</RestRateMultiplier>
        </statFactors>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.3</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.3</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>restrained</label>
        <painFactor>0.5</painFactor>
        <hungerRateFactor>1.15</hungerRateFactor>
        <restFallFactor>2</restFallFactor>
        <statFactors>
          <RestRateMultiplier>0.001</RestRateMultiplier>
        </statFactors>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="TheMarkedMen.HediffCompProperties_Restrained" />
    </comps>
  </HediffDef>
</Defs>
