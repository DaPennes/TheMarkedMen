<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThinkTreeDef>
    <defName>CA_HunterThinkTree</defName>
    <label>Crossed Hunter Think Tree</label>
    <thinkRoot Class="Verse.AI.ThinkNode_Priority">
      <subNodes>
        <!-- Find nearest non-infected target -->
        <li Class="TheMarkedMen.JobGiver_FindNearestTarget" />

        <!-- Hunt wounded/downed targets preferentially -->
        <li Class="TheMarkedMen.JobGiver_HuntWounded" />

        <!-- Coordinate pack attacks -->
        <li Class="TheMarkedMen.JobGiver_FlankTarget" />

        <!-- Take cover if under fire -->
        <li Class="TheMarkedMen.JobGiver_TakeCover" />

        <!-- Retreat if outgunned -->
        <li Class="TheMarkedMen.JobGiver_RetreatIfOutgunned" />

        <!-- Default: wait/idle -->
        <li Class="Verse.AI.ThinkNode_Wait" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
