<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============================================================
       Need Definitions for The Marked Men mod
       Custom needs that govern pawn states and behaviors.
       ============================================================ -->

  <!-- A predator's craving for violence. Low bloodlust causes a negative mood.
       Kills and combat satisfy the craving. -->
  <NeedDef>
    <defName>CA_MarkedBloodlustNeed</defName>
    <label>Bloodlust</label>
    <needClass>TheMarkedMen.Need_MarkedBloodlust</needClass>
    <description>A predator's craving for violence. Low bloodlust causes a negative mood. Kills and combat satisfy the craving.</description>
    <freezeWhileSleeping>true</freezeWhileSleeping>
    <showOnNeedList>true</showOnNeedList>
  </NeedDef>
</Defs>