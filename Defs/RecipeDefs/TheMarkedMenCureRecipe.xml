<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============================================================
       Recipe Definitions for The Marked Men mod
       Crafting recipes for cure equipment and syringes.
       ============================================================ -->

  <!-- Recipe to craft a cure syringe from infected blood sample.
       Unlocks with Marked virus research. -->
  <RecipeDef>
    <defName>TheMarkedMen_Cure_Syringe_Make</defName>
    <label>make cure syringe</label>
    <description>Craft a cure for the Marked Virus infection.</description>
    <jobString>Crafting cure syringe.</jobString>
    <workAmount>2000</workAmount>
    <researchPrerequisite>TheMarkedMen_MarkedVirusResearch</researchPrerequisite>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>TheMarkedMen_InfectedBloodSample</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <TheMarkedMen_Cure_Syringe>1</TheMarkedMen_Cure_Syringe>
    </products>
  </RecipeDef>
</Defs>