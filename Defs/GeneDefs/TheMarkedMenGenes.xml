<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============================================================
       Gene Definitions for The Marked Men mod
       Custom genes governing Marked Virus infection, immunity, and traits
       Required DLC: Biotech
       ============================================================ -->

  <!-- Grants complete immunity to the Marked Virus. Prevents infection from all Marked Virus exposure and improves immunity gain. -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>CA_CrossVirusResistance</defName>
    <label>Marked Virus Immunity</label>
    <description>A gene that grants complete immunity to the Marked Virus. Prevents infection from all Marked Virus exposure and improves immunity gain.</description>
    <iconPath>UI/Genes/Marked Immune Gene/Marked Immune Gene</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ImmunityGainSpeed>0.18</ImmunityGainSpeed>
    </statOffsets>
  </GeneDef>

  <!-- Reduces the chance of contracting the Marked Virus by 75% after direct exposure. -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>CA_MarkedVirusResistanceGene</defName>
    <label>Marked Virus Resistance</label>
    <description>Unusual immune markers reduce the chance of contracting the Marked Virus by 75% after direct exposure.</description>
    <iconPath>UI/Genes/Marked Immune Gene/Marked Immune Gene</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
  </GeneDef>

  <!-- Gene for marked bloodlust is defined in TheMarkedMenPredatorGenes.xml to avoid duplicate DefName -->
</Defs>