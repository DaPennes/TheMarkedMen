<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============================================================
       Incident Definitions for The Marked Men mod
       Handles specialized arrival events for survivors and refugees.
       ============================================================ -->

  <!-- A disoriented survivor who wanders into the colony. They may be a genuine refugee,
       a carrier of the virus, or a scout for the Marked Men. -->
  <IncidentDef>
    <defName>CA_LostSurvivor</defName>
    <label>Lost Survivor arrives</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>TheMarkedMen.IncidentWorker_LostSurvivor</workerClass>
    <baseChance>0.25</baseChance>
    <minRefireDays>3</minRefireDays>
    <earliestDay>4</earliestDay>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
    <letterLabel>Lost survivor found</letterLabel>
    <letterText>A disoriented survivor has wandered to the colony's edge. They claim to have been separated from their group days ago and have been traveling alone since. Something about their story feels incomplete, but they seem grateful for shelter.</letterText>
    <letterDef>CA_LostSurvivorLetter</letterDef>
  </IncidentDef>
</Defs>
