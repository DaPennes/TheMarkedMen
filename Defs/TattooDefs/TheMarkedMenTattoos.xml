<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============================================================
       Tattoo Definitions for The Marked Men mod
       Visual tattoos representing Marked Virus rash progression stages.
       ============================================================ -->

  <!-- Stage 1 of the marked rash - early infection, faint cross pattern on face -->
  <TattooDef>
    <defName>CA_Face_CrossedRashStage1</defName>
    <label>marked rash stage 1</label>
    <texPath>Pawn/Tattoos/Head/TheMarkedMenRashHeadStage1</texPath>
    <iconPath>Pawn/Tattoos/Head/TheMarkedMenRashHeadStage1_south</iconPath>
    <tattooType>Face</tattooType>
    <visibleNorth>false</visibleNorth>
    <category>Tribal</category>
    <styleTags>
      <li>TattooFaceTribal</li>
      <li>TattooFaceAbstract</li>
    </styleTags>
  </TattooDef>

  <!-- Stage 2 of the marked rash - established infection, deeper cross pattern -->
  <TattooDef>
