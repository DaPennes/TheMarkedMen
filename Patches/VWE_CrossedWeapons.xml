<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>OskarPotocki.VanillaWeaponsExpanded</li>
      <li>VanillaExpanded.VWE</li>
      <li>VanillaExpanded.VanillaWeaponsExpanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Crossed Civilian: add VWE melee tags for weapon variety -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/weaponTags/li[text()="VWEMeleeBasic"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/weaponTags</xpath>
            <value>
              <li>VWEMeleeBasic</li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
