<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Medieval Overhaul adds medieval-era equipment with custom DankPyon_* tags.
       Its melee weapons and heavy armor already carry vanilla MedievalMelee*/MedievalMilitary
       tags used by the base pawnkinds, so this patch only unlocks the MO-specific tags:
       ranged weapons, grenades, helmets, and the lighter armor tiers. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>dankpyon.medieval.overhaul</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Crossed Civilian: peasant gear -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/apparelTags/li[text()="DankPyon_Peasant"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/apparelTags</xpath>
            <value>
              <li>DankPyon_Peasant</li>
              <li>DankPyon_PeasantHelmet</li>
              <li>MedievalBasic</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/weaponTags/li[text()="DankPyon_Bludgeon"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/PawnKindDef[defName="CA_CrossedCivilian"]/weaponTags</xpath>
            <value>
              <li>DankPyon_Bludgeon</li>
              <li>DankPyon_Pitchfork</li>
              <li>DankPyon_HookedBlade</li>
              <li>DankPyon_Pickaxe</li>
              <li>DankPyon_Hatchet</li>
              <li>DankPyon_WoodcuttersAxe</li>
            </value>
          </nomatch>
        </li>

        <!-- Crossed Scout: light skirmisher gear -->
