              <li>DankPyon_Peasant</li>
              <li>DankPyon_PeasantHelmet</li>
              <li>DankPyon_BrigandThug</li>
              <li>MedievalBasic</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="CA_CrossedScout"]/weaponTags/li[text()="DankPyon_HuntingBow"]</xpath>
